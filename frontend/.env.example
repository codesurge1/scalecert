# Supabase project URL (same value as the backend's SUPABASE_URL)
VITE_SUPABASE_URL=

# Supabase anon (public) key — the frontend never uses the service-role key
VITE_SUPABASE_ANON_KEY=

# Backend API base. Leave blank in production (same-origin "/api" is the
# default). For local dev, set to http://localhost:8000/api — the backend's
# routes live under /api even locally.
VITE_API_BASE=
