# Supabase project URL
SUPABASE_URL=

# Supabase anon (public) key — safe for client use, subject to RLS
SUPABASE_ANON_KEY=

# Supabase service-role key — backend only; never for user-scoped queries
SUPABASE_SERVICE_ROLE_KEY=

# POOLED connection string (Supavisor, transaction mode) — not the direct connection
DATABASE_URL=

# Storage bucket for generated PDF certificates/reports
SUPABASE_STORAGE_BUCKET=reports
