# Supabase project URL
SUPABASE_URL=

# Supabase anon (public) key — safe for client use, subject to RLS
SUPABASE_ANON_KEY=

# Supabase service-role key — backend only; never for user-scoped queries
SUPABASE_SERVICE_ROLE_KEY=

# POOLED connection string (Supavisor, transaction mode) — not the direct connection
DATABASE_URL=

# Storage bucket for generated PDF certificates/reports
SUPABASE_STORAGE_BUCKET=reports

# Optional override for the public base URL a certificate's QR code points
# at (https://<this>/verify/{certificate_number}). Leave blank to derive it
# from the incoming request's own Host (correct by default in production
# and on every Vercel preview deploy, since frontend+backend share one
# domain — docs/architecture.md). Set this only if that assumption ever
# turns out wrong behind some other proxy layer.
PUBLIC_APP_BASE_URL=
