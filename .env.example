# Supabase project URL
SUPABASE_URL=

# Supabase anon (public) key — safe for client use, subject to RLS
SUPABASE_ANON_KEY=

# Supabase service-role key — backend only; never for user-scoped queries
SUPABASE_SERVICE_ROLE_KEY=

# POOLED connection string (Supavisor, transaction mode) — not the direct connection
DATABASE_URL=

# Storage bucket for generated PDF certificates/reports
SUPABASE_STORAGE_BUCKET=reports

# REQUIRED in production (fix/certificate-generation-wiring) — the public
# base URL a certificate's QR code encodes (https://<this>/verify/{certificate_number}).
# Certificate generation now fails loudly with a clear error if this is
# unset, rather than falling back to the backend's own request.base_url:
# behind Vercel's two-service `/api/:path*` rewrite (docs/architecture.md),
# that fallback is not reliably the public-facing domain the browser
# actually used, and a silently WRONG URL baked into an issued
# certificate's QR code is worse than refusing to generate one. Local dev:
# set to http://localhost:8000 (or wherever the backend is actually
# reachable) to exercise this feature; leaving it blank only breaks
# certificate generation specifically, nothing else.
PUBLIC_APP_BASE_URL=
